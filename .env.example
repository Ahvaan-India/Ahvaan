# Pooled Postgres connection string (Neon / Supabase pooler / @vercel/postgres).
# Configure this in Vercel Project Settings > Environment Variables, never hardcode.
POSTGRES_URL=postgres://user:password@host:5432/db?sslmode=require

# Twilio WhatsApp configuration
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# TWILIO_CONTENT_SID=your_twilio_content_sid

# Alternative 1: WATI.io WhatsApp API configuration
# WATI_API_ENDPOINT=https://live-mt-server.wati.io
# WATI_ACCESS_TOKEN=your_wati_bearer_token

# Alternative 2: Meta WhatsApp Business Cloud API / Custom Gateway settings
# WHATSAPP_API_TOKEN=your_meta_whatsapp_cloud_token
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# WHATSAPP_API_URL=https://api.avhaan.gov.in/whatsapp/send
