# Pooled Postgres connection string (Neon / Supabase pooler / @vercel/postgres).
# Configure this in Vercel Project Settings > Environment Variables, never hardcode.
POSTGRES_URL=postgres://user:password@host:5432/db?sslmode=require

# Redis cache between the website and Postgres (optional but recommended).
# Any Redis URL works (Upstash, Railway, local `redis-server`).
# When unset, the site falls back to an in-memory TTL cache with identical semantics.
# REDIS_URL=rediss://default:token@host:6379

# Email alerts (notification channel, SMTP via nodemailer).
# Works with Gmail App Passwords, Outlook, SES SMTP, or Mailtrap (dev).
# When unset, sends return SIMULATED_SENT (nothing is delivered).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=alerts@example.gov.in
# SMTP_PASS=your_smtp_password_or_app_password
# EMAIL_FROM=Ahvaan Heat Alerts <alerts@example.gov.in>
# ALERT_DEFAULT_EMAIL=heat-officer@example.gov.in

# Ahvaan Assistant chatbot (Cloudflare Workers AI).
# Get these from dash.cloudflare.com → Workers & Pages → AI, or via
# `npx wrangler whoami` / API Tokens (Workers AI read + run).
# CLOUDFLARE_ACCOUNT_ID=your_32_char_account_id
# CLOUDFLARE_API_TOKEN=your_api_token_with_workers_ai_access
# CLOUDFLARE_MODEL=@cf/zai-org/glm-4.7-flash
