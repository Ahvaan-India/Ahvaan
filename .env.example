# Pooled Postgres connection string — READ-ONLY (backend forecast/analysis
# tables). This project never writes to Postgres.
# Configure this in Vercel Project Settings > Environment Variables, never hardcode.
POSTGRES_URL=postgres://user:password@host:5432/db?sslmode=require

# MongoDB connection string — all app writes live here (OTP codes, users,
# zone subscriptions). Any Atlas cluster or self-hosted Mongo works.
# MONGO_URL=mongodb+srv://user:password@cluster.host/db?retryWrites=true&w=majority

# Redis cache — used ONLY for backend analysis payloads (/api/field
# analysis layers, /api/zone). Everything else is process-memory cached.
# Any Redis URL works (Upstash, Railway, local `redis-server`).
# When unset, analysis payloads fall back to the in-memory TTL cache.
# REDIS_URL=rediss://default:token@host:6379

# Phone+OTP login sessions (required for login/alerts).
# Random string, e.g. `openssl rand -hex 32`.
# SESSION_SECRET=change_me_to_a_random_string

# Email delivery for OTP codes + ward alerts (nodemailer SMTP).
# Works with Gmail App Passwords, Outlook, SES SMTP, or Mailtrap (dev).
# Without SMTP configured, sends return SIMULATED_SENT (logged, nothing
# delivered) and OTP codes are returned in non-production API responses.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=alerts@example.gov.in
# SMTP_PASS=your_smtp_password_or_app_password
# EMAIL_FROM=Ahvaan Heat Alerts <alerts@example.gov.in>

# Ahvaan Assistant chatbot (Cloudflare Workers AI).
# Get these from dash.cloudflare.com → Workers & Pages → AI, or via
# `npx wrangler whoami` / API Tokens (Workers AI read + run).
# CLOUDFLARE_ACCOUNT_ID=your_32_char_account_id
# CLOUDFLARE_API_TOKEN=your_api_token_with_workers_ai_access
# CLOUDFLARE_MODEL=@cf/zai-org/glm-4.7-flash
